PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/quizzes_dev
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
SALT_ROUNDS=10
CONFIG_LEVEL=info
SOCKET_PATH=/socket.io

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY_TEST=sk_test_...
PAYSTACK_SECRET_KEY_LIVE=sk_live_...

# Core URLs & Queues
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=Changeme123!

# AI Provider Settings ("openrouter" | "google" | "groq")
AI_PROVIDER=openrouter
AI_DEFAULT_MODEL=openai/openrouter/free
PAID_AI_MODEL=openai/gpt-4o-mini
PAID_AI_FALLBACK_MODEL=openai/gpt-4o
AI_TIER_OVERRIDE=auto
AI_ALLOW_FREE_USER_PAID_MODELS=false
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.7
AI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Groq Settings (Tested & Verified Fast Tool Calling Models)
GROQ_API_KEY=gsk_...
GROQ_DEFAULT_MODEL=groq/openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=groq/openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=groq/qwen/qwen3.8-27b

# AI Credit System
AI_CREDITS_PER_MESSAGE=1
AI_LOW_CREDIT_THRESHOLD=5

# OpenRouter Settings (Tested & Verified Active Models)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/openrouter/free
OPENROUTER_FALLBACK_MODEL=openai/openrouter/auto
OPENROUTER_FALLBACK_MODEL_2=openai/cohere/north-mini-code:free
OPENROUTER_SITE_URL=https://q.prestoghana.com
OPENROUTER_SITE_NAME="Presto Q"

# Google GenAI Settings (Tested & Verified Active Models)
GOOGLE_GENAI_API_KEY=
GEMINI_DEFAULT_MODEL=googleai/gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email / SMTP Settings
SMTP_USER=
SMTP_PASS=
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_FROM_NAME="BetaForge Labs"
SMTP_FROM_EMAIL=

# Web Push (VAPID)
VAPID_SUBJECT=mailto:admin@bflabs.tech
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Mascot Assets
EMAIL_QUBI_PEEK_URL=
EMAIL_QUBI_STUDY_URL=
EMAIL_QUBI_WAVE_URL=
